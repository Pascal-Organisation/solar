# /etc/solar/env — root:root 0600. Read by the collector and web containers; keep secrets out.

# Inverter on the LAN (GoodWe Wi-Fi/LAN dongle, UDP 8899)
SOLAR_INVERTER_HOST=192.168.x.y
# Optional: skip auto-detection (ET, EH, BT, BH, ES, EM, BP, DT, MS, D-NS, XS)
SOLAR_INVERTER_FAMILY=ET
# Live refresh (dashboard, metrics). The dongle handled 1 s without errors in tests.
SOLAR_POLL_INTERVAL=2
# Raw history resolution; daily kWh come from the inverter's counters regardless.
SOLAR_STORE_INTERVAL=10
SOLAR_RAW_RETENTION_DAYS=30
TZ=Europe/Berlin

# Tariff in EUR/kWh for the savings figures (0 or unset hides them)
SOLAR_PRICE_IMPORT=0.33
SOLAR_PRICE_EXPORT=0.08

# One-off SEMS history import only — do NOT keep these here permanently.
# Pass them on the command line of the import run instead (see deploy/README.md).
# SEMS_ACCOUNT=
# SEMS_PASSWORD=
