# /etc/solar/env — root:root 0600. Read by the collector container only.

# Inverter on the LAN (GoodWe Wi-Fi/LAN dongle, UDP 8899)
SOLAR_INVERTER_HOST=192.168.x.y
# Optional: skip auto-detection (ET, EH, BT, BH, ES, EM, BP, DT, MS, D-NS, XS)
SOLAR_INVERTER_FAMILY=ET
SOLAR_POLL_INTERVAL=10
SOLAR_RAW_RETENTION_DAYS=30
TZ=Europe/Berlin

# One-off SEMS history import only — do NOT keep these here permanently.
# Pass them on the command line of the import run instead (see deploy/README.md).
# SEMS_ACCOUNT=
# SEMS_PASSWORD=
