[Unit]
Description=solar: verify and deploy the latest signed image (app-deploy)
Documentation=https://github.com/Pascal-Organisation/solar/blob/main/deploy/README.md
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/app-deploy solar
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
